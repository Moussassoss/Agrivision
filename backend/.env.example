# Copy this to .env and fill in your values.
# Never commit .env — it is gitignored.

APP_NAME="CropVana API"
APP_VERSION="1.0.0"
DEBUG=false                   # true = enables Swagger UI + verbose logs
ALLOWED_ORIGINS=["*"]         # Lock to real domains in production

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-at-least-32-chars

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days

# Option A — local PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/cropvana
# Option B — Render external URL (Dashboard → your DB → Connect → External URL):
#   DATABASE_URL=postgres://user:password@dpg-xxx.oregon-postgres.render.com/cropvana
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/cropvana

# iSDAsoil — register at https://www.isda-africa.com/isdasoil/
ISDA_USERNAME=your_isdasoil_email
ISDA_PASSWORD=your_isdasoil_password

# OpenWeather — https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Resend email — https://resend.com (free: 3000 emails/month)
# Without this, OTPs are only logged to the server console (dev mode).
RESEND_API_KEY=re_xxxxxxxxxxxx
# Change to your verified domain once you add it to Resend:
EMAIL_FROM=CropVana <onboarding@resend.dev>

# Sentry error monitoring — https://sentry.io (free tier available)
# Leave empty to disable.
SENTRY_DSN=
